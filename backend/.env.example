# Genera la tuya con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# En producción es obligatoria y debe tener 32 caracteres o más.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Descomenta estas líneas para usar Postgres en lugar de SQLite
# POSTGRES_DB=duckyroom
# POSTGRES_USER=duckyroom
# POSTGRES_PASSWORD=duckyroom
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
